{
  "name": "Pocket Studio",
  "short_name": "Pocket Studio",
  "description": "Record, master, transcribe, shrink video and keep your songbook. Works in airplane mode. Pay once.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101722",
  "theme_color": "#101722",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Studio", "url": "./" },
    { "name": "Songbook", "url": "./songbook/" }
  ],
  "share_target": {
    "action": "./songbook/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
